{
  "private": true,
  "name": "terriajs-map",
  "version": "0.4.8",
  "description": "Geospatial catalog explorer based on TerriaJS.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 22"
  },
  "repository": {
    "type": "git",
    "url": "http://github.com/TerriaJS/TerriaMap"
  },
  "dependencies": {
    "terriajs": "git+https://github.com/pabrojast/terriajs.git#bc3f81025e3e6b066a1e9444218a37e99e9e8118",
    "terriajs-server": "git+https://github.com/pabrojast/terriajs-server.git#5c458df30eaf10e1189717539a1cc064df7f2abf"
  },
  "config": {
    "docker": {
      "name": "terriamap",
      "include": "wwwroot node_modules serverconfig.json index.js package.json version.js",
      "dockerfile": "deploy/docker/Dockerfile"
    }
  },
  "resolutions": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.1",
    "tinymce": "^7.9.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "10.0.1",
    "@types/jasmine-ajax": "^3.3.0",
    "@types/react-test-renderer": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "babel-loader": "^10.1.1",
    "babel-plugin-styled-components": "^2.1.4",
    "css-loader": "^7.1.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fetch-mock": "^11.1.5",
    "fork-ts-checker-notifier-webpack-plugin": "^9.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "fs-extra": "^7.0.1",
    "globals": "17.13.0",
    "gulp": "^5.0.1",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "is-subdir": "^1.2.0",
    "jasmine-ajax": "^4.0.0",
    "json5": "^2.2.3",
    "lodash": "^4.17.21",
    "mini-css-extract-plugin": "^2.10.2",
    "minimist": "^1.2.8",
    "msw": "^2.15.0",
    "node-notifier": "^10.0.1",
    "plugin-error": "^2.0.1",
    "prettier": "3.8.1",
    "pretty-quick": "^4.2.2",
    "prop-types": "^15.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.98.0",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "svg-sprite": "^2.0.4",
    "terriajs-cesium": "26.3.0",
    "terriajs-plugin-api": "0.0.1-alpha.17",
    "terriajs-plugin-sample": "0.0.1-alpha.7",
    "terriajs-typings-for-css-modules-loader": "^2.5.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.71.2",
    "urijs": "^1.18.12",
    "webpack": "^5.111.0",
    "webpack-cli": "^5.1.4",
    "yargs": "^17.7.2"
  },
  "scripts": {
    "docker-build-local": "node deploy/docker/create-docker-context.js --build --push --tag auto --local",
    "docker-build-prod": "node deploy/docker/create-docker-context.js --build --push --tag auto --repository=ghcr.io/terriajs",
    "docker-build-ci": "node deploy/docker/create-docker-context.js --build",
    "start": "terriajs-server --config-file serverconfig.json",
    "gulp": "gulp",
    "build": "gulp build",
    "dev": "gulp dev",
    "postinstall": "echo 'Installation successful. What to do next:\\n  yarn gulp dev   # Starts the server on port 3001, builds TerriaMap and dependencies, and rebuilds if files change.'",
    "prettier": "prettier --write .",
    "prettier-check": "prettier --check .",
    "lint": "gulp lint"
  }
}
