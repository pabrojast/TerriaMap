              "id": "annual",
              "name": "Annual",
              "url": "https://ihpwinsdata.blob.core.windows.net/data/xcube/config/chl-annual.json",
              "dateFormat": "UTC:yyyy",
              "fromContinuous": "previous",
              "renderOptions": { "single": { "domain": [0, 60] } }
            },
            {
              "id": "monthly",
              "name": "Monthly",
              "url": "https://ihpwinsdata.blob.core.windows.net/data/xcube/config/chl-monthly.json",
              "dateFormat": "UTC:mmm yyyy",
              "fromContinuous": "previous",
              "renderOptions": { "single": { "domain": [0, 80] } }
            },
            {
              "id": "daily",
              "name": "Daily",
              "url": "https://ihpwinsdata.blob.core.windows.net/data/xcube/config/chl-daily.json",
              "dateFormat": "UTC:d mmm yyyy",
              "fromContinuous": "nearest",
              "valueScale": 0.1,
              "valueOffset": 0,
              "partialCoverage": true,
              "renderOptions": { "single": { "domain": [0, 100] } }
            }
          ]
        },
        {
