{
  "catalog": [
    {
      "name": "GLIMS & RGI Glaciers",
      "type": "group",
      "description": "Glacier outlines and inventory from GLIMS (Global Land Ice Measurements from Space) and the Randolph Glacier Inventory (RGI), curated by NSIDC.",
      "info": [
        {
          "name": "About",
          "content": "GLIMS (Global Land Ice Measurements from Space) is an international initiative to map and monitor the world's glaciers using satellite data. The Randolph Glacier Inventory (RGI) is a globally complete inventory of glacier outlines, widely used in climate and hydrological studies."
        },
        {
          "name": "Attribution",
          "content": "Data served by GLIMS/NSIDC. GLIMS: Global Land Ice Measurements from Space (https://www.glims.org). RGI: Randolph Glacier Inventory v7.0 (RGI Consortium). Contact organization (WMS): National Snow and Ice Data Center (NSIDC)."
        },
        {
          "name": "Access & License",
          "content": "WMS GetCapabilities indicates Fees: NONE and AccessConstraints: NONE. Please cite GLIMS and the RGI Consortium when using these data."
        },
        {
          "name": "Links",
          "content": "GLIMS: https://www.glims.org | RGI: https://www.glims.org/RGI/"
        }
      ],
      "infoSectionOrder": ["About", "Attribution", "Access & License", "Links"],
